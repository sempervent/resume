{
  "$defs": {
    "Metric": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "value",
        "verification"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Verification": {
      "properties": {
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "status",
        "sources"
      ],
      "title": "Verification",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "source-supported",
        "owner-verification-required",
        "independently-checked"
      ],
      "title": "VerificationStatus",
      "type": "string"
    },
    "Visibility": {
      "enum": [
        "public",
        "private",
        "restricted"
      ],
      "title": "Visibility",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "employment_id": {
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$",
      "title": "Employment Id",
      "type": "string"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "categories": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Categories",
      "type": "array"
    },
    "technologies": {
      "items": {
        "type": "string"
      },
      "title": "Technologies",
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "visibility": {
      "$ref": "#/$defs/Visibility",
      "default": "public"
    },
    "review_required": {
      "default": false,
      "title": "Review Required",
      "type": "boolean"
    },
    "disclosure_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disclosure Notes"
    }
  },
  "required": [
    "id",
    "employment_id",
    "statement",
    "categories",
    "verification"
  ],
  "title": "Achievement",
  "type": "object"
}
